# Настройки LLM для HelloAgents
# Используется ModelScope API (рекомендуется)
LLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=your-modelscope-api-key-here
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/

# Другие доступные модели:
# LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# LLM_MODEL_ID=deepseek-ai/DeepSeek-V3

# Если используете другой сервис, совместимый с OpenAI
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_ID=deepseek-chat

# ================================
# Настройки векторной БД Qdrant
# ================================
# Облачный сервис Qdrant (рекомендуется)
# https://cloud.qdrant.io/
QDRANT_URL=https://xxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=xxxxx

# Либо локальный Qdrant (нужен Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Настройки коллекции Qdrant
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Настройки графовой БД Neo4j
# ================================
# Облачный сервис Neo4j Aura (рекомендуется)
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xxxxx

# Либо локальный Neo4j (нужен Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Настройки подключения Neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

EMBED_MODEL_TYPE="local"
# EMBED_MODEL_NAME="text-embedding-v3"
# # — если пусто: для dashscope по умолчанию text-embedding-v3; для local — sentence-transformers/all-MiniLM-L6-v2
# EMBED_API_KEY=""
# EMBED_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
