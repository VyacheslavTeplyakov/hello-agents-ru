# ============================================================================
# HelloAgents — единый файл конфигурации переменных окружения
# ============================================================================
# Скопируйте этот файл под именем .env и введите ваши API-ключи
# Системные требования: Python 3.10+ (обязательно)

# ============================================================================
# Единый формат конфигурации (рекомендуется) — фреймворк автоматически определяет провайдера
# ============================================================================
# Достаточно задать 4 общих переменных окружения — фреймворк сам определит LLM-провайдера:

# Имя модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Адрес сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (опционально, по умолчанию 60 секунд)
LLM_TIMEOUT=60

# ============================================================================
# Конфигурация инструментов (опционально)
# ============================================================================

# Поиск Tavily (рекомендуется) — получить API-ключ: https://tavily.com/
# TAVILY_API_KEY=tvly-your_tavily_key_here

# Поиск SerpApi (альтернатива) — получить API-ключ: https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# ================================
# Конфигурация векторной базы данных Qdrant — получить API-ключ: https://cloud.qdrant.io/
# ================================
# Использование облачного сервиса Qdrant (рекомендуется)
QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Или локальный Qdrant (требуется Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Конфигурация коллекции Qdrant
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Конфигурация графовой базы данных Neo4j — получить API-ключ: https://neo4j.com/cloud/aura/
# ================================
# Использование облачного сервиса Neo4j Aura (рекомендуется)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Или локальный Neo4j (требуется Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Параметры подключения Neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# Конфигурация эмбеддингов — можно получить в консоли Alibaba Cloud: https://dashscope.aliyun.com/
# ==========================
# - Если пусто: dashscope по умолчанию использует text-embedding-v3; local — sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=

# ================================
# Конфигурация GitHub API
# ================================
# Персональный токен GitHub — для доступа к GitHub API
# Как получить: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# ================================
# Конфигурация HuggingFace API
# ================================
# Токен HuggingFace — для доступа к закрытым датасетам (например, GAIA)
# Как получить: https://huggingface.co/settings/tokens
HF_TOKEN=
