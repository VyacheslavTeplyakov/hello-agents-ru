
# Конфигурация LLM (наследуется от HelloAgents, при необходимости можно переопределить)
# Название модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Адрес сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (необязательно, по умолчанию 60 секунд)
LLM_TIMEOUT=60

# Настройки сервера
HOST=0.0.0.0
PORT=8000

# Настройки CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Уровень журналирования
LOG_LEVEL=INFO

# Учётные данные Unsplash API
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# Настройки API карт AMap
AMAP_API_KEY=your_amap_api_key_here