# ============================================================================
# HelloAgents — единый файл конфигурации переменных окружения
# ============================================================================
# Скопируйте этот файл как .env и заполните свои API-ключи
# Системные требования: Python 3.10+ (обязательно)

# ============================================================================
# Единый формат конфигурации (рекомендуется) — фреймворк автоматически определяет провайдера
# ============================================================================
# Достаточно задать следующие 4 общие переменные окружения — фреймворк автоматически распознает провайдера LLM:

# Название модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Адрес сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (необязательно, по умолчанию 60 секунд)
LLM_TIMEOUT=60

# ============================================================================
# Настройки инструментов (необязательно)
# ============================================================================

# ================================
# Конфигурация GitHub API
# ================================
# GitHub Personal Access Token — для доступа к GitHub API
# Способ получения: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
