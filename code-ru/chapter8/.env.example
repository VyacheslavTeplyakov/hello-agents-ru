# ============================================================================
# HelloAgents — единый файл конфигурации переменных окружения
# ============================================================================
# Скопируйте этот файл в .env и заполните ваши API-ключи
# Требования: Python 3.10+ (обязательно)

# ============================================================================
# 🚀 Унифицированный формат конфигурации (рекомендуется) — фреймворк определяет провайдера автоматически
# ============================================================================
# Достаточно задать 4 переменные ниже — фреймворк сам определит LLM-провайдера:

# Название модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Базовый URL сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (необязательно, по умолчанию 60 сек)
LLM_TIMEOUT=60

# ============================================================================
# 🛠️ Конфигурация инструментов (необязательно)
# ============================================================================

# Tavily Search (рекомендуется) — получить API-ключ: https://tavily.com/
# TAVILY_API_KEY=tvly-your_tavily_key_here

# SerpApi Search (альтернатива) — получить API-ключ: https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# ================================
# Qdrant — векторная база данных — API-ключ: https://cloud.qdrant.io/
# ================================
# Облачный Qdrant (рекомендуется)
QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Или локальный Qdrant (требует Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Конфигурация коллекции Qdrant
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j — графовая база данных — API-ключ: https://neo4j.com/cloud/aura/
# ================================
# Neo4j Aura облако (рекомендуется)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Или локальный Neo4j (требует Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Параметры подключения Neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# Конфигурация эмбеддингов — ключ из консоли Alibaba Cloud: https://dashscope.aliyun.com/
# ==========================
# Если пусто: dashscope использует text-embedding-v3; local — sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=
