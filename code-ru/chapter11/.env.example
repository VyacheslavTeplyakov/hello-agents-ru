# ============================================================================
# HelloAgents Chapter 11 - Agentic RL — пример файла переменных окружения
# ============================================================================
# Скопируй этот файл как .env и заполни свои API-ключи и настройки
# Требования к системе: Python 3.10+ (обязательно)

# ============================================================================
# 🚀 Унифицированный формат конфигурации (рекомендуется) — фреймворк определяет провайдера автоматически
# ============================================================================
# Достаточно задать следующие 4 переменные — фреймворк сам определит LLM-провайдера:

# Название модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Адрес сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (необязательно, по умолчанию 60 секунд)
LLM_TIMEOUT=60

# ============================================================================
# 🤖 Конфигурация обучения с подкреплением
# ============================================================================

# --------------------------------
# Конфигурация модели для обучения
# --------------------------------
# Базовая модель (для SFT и GRPO-обучения)
# Рекомендуется использовать небольшие модели для экспериментов: Qwen3-0.6B, Qwen2.5-0.5B-Instruct
RL_BASE_MODEL=Qwen/Qwen3-0.6B

# Директория для сохранения результатов обучения
RL_OUTPUT_DIR=./outputs

# --------------------------------
# Конфигурация датасета
# --------------------------------
# Название датасета (по умолчанию используется математический датасет GSM8K)
RL_DATASET_NAME=openai/gsm8k

# Конфигурация датасета
RL_DATASET_CONFIG=main

# Сплит датасета
RL_DATASET_SPLIT=train

# Максимальное кол-во примеров (для быстрых экспериментов; -1 — использовать все данные)
RL_MAX_SAMPLES=100

# --------------------------------
# Гиперпараметры SFT-обучения
# --------------------------------
# Кол-во эпох
SFT_NUM_EPOCHS=3

# Размер батча
SFT_BATCH_SIZE=4

# Шаги накопления градиентов
SFT_GRADIENT_ACCUMULATION_STEPS=4

# Скорость обучения
SFT_LEARNING_RATE=2e-5

# Максимальная длина последовательности
SFT_MAX_SEQ_LENGTH=512

# Конфигурация LoRA
SFT_LORA_R=8
SFT_LORA_ALPHA=16
SFT_LORA_DROPOUT=0.05

# --------------------------------
# Гиперпараметры GRPO-обучения
# --------------------------------
# Кол-во эпох
GRPO_NUM_EPOCHS=2

# Размер батча
GRPO_BATCH_SIZE=4

# Шаги накопления градиентов
GRPO_GRADIENT_ACCUMULATION_STEPS=4

# Скорость обучения
GRPO_LEARNING_RATE=1e-5

# Максимальная длина последовательности
GRPO_MAX_SEQ_LENGTH=512

# Кол-во ответов, генерируемых на один промпт
GRPO_NUM_GENERATIONS=4

# Коэффициент штрафа KL-дивергенции
GRPO_KL_COEF=0.1

# Конфигурация LoRA
GRPO_LORA_R=8
GRPO_LORA_ALPHA=16
GRPO_LORA_DROPOUT=0.05

# --------------------------------
# Конфигурация функции вознаграждения
# --------------------------------
# Тип функции вознаграждения: accuracy, length_penalty, step_penalty
REWARD_TYPE=accuracy

# Коэффициент штрафа за длину (только для length_penalty)
REWARD_LENGTH_PENALTY=0.01

# Коэффициент штрафа за шаги (только для step_penalty)
REWARD_STEP_PENALTY=0.05

# --------------------------------
# Конфигурация распределённого обучения
# --------------------------------
# Включить распределённое обучение
DISTRIBUTED_TRAINING=false

# Стратегия распределённого обучения: ddp, deepspeed_zero2, deepspeed_zero3
DISTRIBUTED_STRATEGY=ddp

# Кол-во GPU (-1 — использовать все доступные GPU)
NUM_GPUS=-1

# Путь к конфигурационному файлу DeepSpeed (необязательно)
# DEEPSPEED_CONFIG=./accelerate_configs/deepspeed_zero2.yaml

# --------------------------------
# Конфигурация мониторинга и логирования
# --------------------------------
# Включить TensorBoard
ENABLE_TENSORBOARD=true

# Директория логов TensorBoard
TENSORBOARD_LOG_DIR=./logs/tensorboard

# Включить Wandb
ENABLE_WANDB=false

# Название проекта в Wandb
# WANDB_PROJECT=helloagents-rl

# API-ключ Wandb (получить: https://wandb.ai/authorize)
# WANDB_API_KEY=your_wandb_api_key_here

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Интервал логирования (в шагах)
LOGGING_STEPS=10

# Интервал сохранения модели (в шагах)
SAVE_STEPS=100

# Интервал оценки (в шагах)
EVAL_STEPS=100

# --------------------------------
# Конфигурация железа и производительности
# --------------------------------
# Смешанная точность обучения: no, fp16, bf16
MIXED_PRECISION=bf16

# Контрольные точки градиентов (экономия видеопамяти)
GRADIENT_CHECKPOINTING=true

# Кол-во рабочих процессов DataLoader
DATALOADER_NUM_WORKERS=4

# Фиксировать ли случайное зерно
SEED=42

# ================================
# Конфигурация HuggingFace API
# ================================
# HuggingFace Token — для загрузки моделей и датасетов
# Получить: https://huggingface.co/settings/tokens
HF_TOKEN=

# Зеркало HuggingFace (необязательно, для ускорения загрузки)
# Пользователи из России могут использовать следующее зеркало:
# HF_ENDPOINT=https://hf-mirror.com

# ================================
# Конфигурация кэша моделей
# ================================
# Директория кэша моделей HuggingFace
# HF_HOME=~/.cache/huggingface

# Директория кэша Transformers
# TRANSFORMERS_CACHE=~/.cache/huggingface/transformers

# ============================================================================
# 📝 Примечания по конфигурации
# ============================================================================
#
# 1. Базовая конфигурация:
#    - Обязательно задай переменные LLM (LLM_MODEL_ID, LLM_API_KEY, LLM_BASE_URL)
#    - Для RL_BASE_MODEL рекомендуется использовать небольшую модель (например, Qwen3-0.6B)
#
# 2. Конфигурация обучения:
#    - Быстрый эксперимент: RL_MAX_SAMPLES=100, SFT_NUM_EPOCHS=1, GRPO_NUM_EPOCHS=1
#    - Полное обучение: RL_MAX_SAMPLES=-1, увеличь кол-во эпох
#
# 3. Распределённое обучение:
#    - Один GPU: DISTRIBUTED_TRAINING=false
#    - Несколько GPU: DISTRIBUTED_TRAINING=true, выбери подходящую DISTRIBUTED_STRATEGY
#
# 4. Мониторинг:
#    - Локальный: ENABLE_TENSORBOARD=true
#    - Облачный: ENABLE_WANDB=true, задай WANDB_API_KEY
#
# 5. Оптимизация производительности:
#    - Нехватка видеопамяти: включи GRADIENT_CHECKPOINTING, уменьши BATCH_SIZE
#    - Ускорение обучения: используй MIXED_PRECISION=bf16, увеличь GRADIENT_ACCUMULATION_STEPS
#
# ============================================================================
