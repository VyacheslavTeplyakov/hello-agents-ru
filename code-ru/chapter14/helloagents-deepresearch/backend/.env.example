# Поисковый сервис: 'duckduckgo', 'tavily', 'perplexity', searxng
SEARCH_API='duckduckgo'

# Конфигурация LLM (унаследована от HelloAgents; при необходимости переопределить здесь)

# Провайдер модели
LLM_PROVIDER=custom          # Варианты: ollama, lmstudio, custom — ollama и lmstudio для локальных моделей, custom для вызова через API
# Название модели
LLM_MODEL_ID=your-model-name

# API-ключ
LLM_API_KEY=your-api-key-here

# Адрес сервиса
LLM_BASE_URL=your-api-base-url

# Таймаут (необязательно, по умолчанию 60 секунд)
LLM_TIMEOUT=60

# Конфигурация сервера
HOST=0.0.0.0
PORT=8000

# Настройки CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Уровень логирования
LOG_LEVEL=INFO
# Ключи API веб-поиска (выберите один или оба)
# TAVILY_API_KEY=tvly-xxxxx      # Получить ключ на https://tavily.com
# PERPLEXITY_API_KEY=pplx-xxxxx  # Получить ключ на https://www.perplexity.ai
# Для поиска через Searxng по умолчанию используется http://localhost:8888
# SEARXNG_URL=

# Конфигурация локальной модели (LMStudio/Ollama)
# LLM_PROVIDER=lmstudio          # Варианты: ollama, lmstudio
# LOCAL_LLM=qwen_qwq-32b         # Название модели в LMStudio/Ollama
# LMSTUDIO_BASE_URL=http://localhost:1234/v1  # URL OpenAI-совместимого API LMStudio
# OLLAMA_BASE_URL=http://localhost:11434 # Адрес сервиса Ollama, по умолчанию http://localhost:11434

MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True
